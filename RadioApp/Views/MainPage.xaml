<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:RadioApp.Views.Components"
             xmlns:viewModels="clr-namespace:RadioApp.ViewModels"
             xmlns:views="clr-namespace:RadioApp.Views"
             x:Class="RadioApp.Views.MainPage"
             x:Name="Root"
             x:DataType="viewModels:MainViewModel"
             BackgroundColor="#050607"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <components:HeaderView Grid.Row="0"
                               BindingContext="{Binding Source={x:Reference Root}, Path=SearchViewModel, x:DataType=views:MainPage}" />

        <Grid Grid.Row="1" Padding="28,0,28,20">
            <components:PlayerView CurrentStation="{Binding SelectedStation}" />
        </Grid>

        <Grid x:Name="StationLists" Grid.Row="2" Padding="28,0,28,12" IsEnabled="False">
            <components:StationSearchView
                BindingContext="{Binding Source={x:Reference Root}, Path=SearchViewModel, x:DataType=views:MainPage}"
                FavoriteStations="{Binding Source={x:Reference Root}, Path=FavoriteStationsViewModel.FavoriteStations, x:DataType=views:MainPage}"
                IsVisible="{Binding Source={x:Reference Root}, Path=SearchViewModel.IsSearchVisible, x:DataType=views:MainPage}"
                StationSelected="OnStationSelected" FavoriteAddRequested="OnFavoriteAddRequested"
                FavoriteToggleRequested="OnFavoriteToggleRequested" />

            <Grid RowDefinitions="Auto,*" RowSpacing="20">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid"
                                 Binding="{Binding Source={x:Reference Root}, Path=SearchViewModel.IsSearchVisible, x:DataType=views:MainPage}"
                                 Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>

                <components:RecommendedStationsView StationSelected="OnStationSelected"
                                                     FavoriteAddRequested="OnFavoriteAddRequested" />

                <components:FavoriteStationsView Grid.Row="1"
                    BindingContext="{Binding Source={x:Reference Root}, Path=FavoriteStationsViewModel, x:DataType=views:MainPage}"
                    StationSelected="OnStationSelected" FavoriteAddRequested="OnFavoriteAddRequested"
                    StationRemoveRequested="OnFavoriteStationRemoveRequested" />
            </Grid>
        </Grid>

        <Border x:Name="FavoriteFeedback" Grid.Row="3" IsVisible="False" Margin="28,0,28,12" Padding="14,10"
                BackgroundColor="#111315" Stroke="#222629" StrokeShape="RoundRectangle 14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label x:Name="FavoriteFeedbackText" FontSize="12" TextColor="#F5F5F5" VerticalOptions="Center" />
                <Button x:Name="RetryFavoritesButton" Grid.Column="1" Text="Ponów" IsVisible="False"
                        Padding="8,0" BackgroundColor="Transparent" TextColor="#59D65D"
                        Clicked="OnRetryFavoritesClicked" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
