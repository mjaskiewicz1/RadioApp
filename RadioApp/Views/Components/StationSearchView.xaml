<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Core.Models;assembly=Core"
             xmlns:enums="clr-namespace:RadioBrowser.Api.Models.Enums;assembly=RadioBrowser"
             xmlns:viewModels="clr-namespace:RadioApp.ViewModels"
             xmlns:components="clr-namespace:RadioApp.Views.Components"
             xmlns:behaviors="clr-namespace:RadioApp.Behaviors"
             xmlns:converters="clr-namespace:RadioApp.Converters"
             x:Class="RadioApp.Views.Components.StationSearchView"
             x:Name="Root"
             x:DataType="viewModels:StationSearchViewModel">

    <ContentView.Resources>
        <converters:FavoriteHeartConverter x:Key="FavoriteHeartConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <Border Grid.Row="0" HeightRequest="46"
                Padding="12,0,4,0"
                BackgroundColor="#111315"
                Stroke="#222629"
                StrokeShape="RoundRectangle 18">
            <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                <Path Grid.Column="0"
                      Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M12.5,12.5 L18,18"
                      Stroke="#59D65D"
                      StrokeThickness="2"
                      WidthRequest="20"
                      HeightRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />

                <Entry Grid.Column="1"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Placeholder="Wyszukaj stację"
                       PlaceholderColor="#96999F"
                       TextColor="#F5F5F5"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="Never"
                       ReturnType="Search"
                       HandlerChanged="OnSearchEntryHandlerChanged"
                       VerticalOptions="Center" />

                <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSearchCommand}" />
                    </Grid.GestureRecognizers>

                    <Path Data="M4,4 L16,16 M16,4 L4,16"
                          Stroke="#96999F"
                          StrokeThickness="2"
                          WidthRequest="18"
                          HeightRequest="18"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Border Grid.Column="0"
                    HeightRequest="38"
                    BackgroundColor="#111315"
                    Stroke="#222629"
                    StrokeShape="RoundRectangle 14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCountryCommand}"
                                          CommandParameter="{x:Static enums:CountryCode.Pl}" />
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedCountry}"
                                 Value="{x:Static enums:CountryCode.Pl}">
                        <Setter Property="BackgroundColor" Value="#101C12" />
                        <Setter Property="Stroke" Value="#59D65D" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Polska"
                       FontSize="12"
                       TextColor="#F5F5F5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Border Grid.Column="1"
                    HeightRequest="38"
                    BackgroundColor="#111315"
                    Stroke="#222629"
                    StrokeShape="RoundRectangle 14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCountryCommand}"
                                          CommandParameter="{x:Static enums:CountryCode.Gb}" />
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedCountry}"
                                 Value="{x:Static enums:CountryCode.Gb}">
                        <Setter Property="BackgroundColor" Value="#101C12" />
                        <Setter Property="Stroke" Value="#59D65D" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Wielka Brytania"
                       FontSize="12"
                       TextColor="#F5F5F5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="WYNIKI" FontAttributes="Bold" FontSize="13" TextColor="#59D65D" />
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsSearching}"
                                   IsVisible="{Binding IsSearching}" Color="#59D65D"
                                   WidthRequest="18" HeightRequest="18" />
            </Grid>

        
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Results, Mode=OneWay}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RadioStation">
                    <Grid ColumnDefinitions="*,44" RowDefinitions="Auto,1" ColumnSpacing="12" RowSpacing="10">
                        <Grid x:Name="StationContent" ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Grid.Behaviors>
                                <behaviors:StationTouchBehavior
                                    BindingContext="{Binding Source={x:Reference StationContent}, Path=BindingContext, x:DataType=Grid}"
                                    StationSelected="OnStationSelected" FavoriteAddRequested="OnFavoriteAddRequested" />
                            </Grid.Behaviors>

                            <Border WidthRequest="44" HeightRequest="44" Padding="4" BackgroundColor="#111315"
                                    Stroke="#222629" StrokeShape="RoundRectangle 12">
                                <Image Source="{Binding Favicon, TargetNullValue=radio_placeholder.svg}"
                                       Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="14" TextColor="#F5F5F5"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding Bitrate, StringFormat='{}{0} kbps', TargetNullValue='— kbps'}"
                                       FontSize="12" TextColor="#96999F" />
                            </VerticalStackLayout>
                        </Grid>

                        <ImageButton Grid.Column="1" WidthRequest="44" HeightRequest="44" Padding="10"
                                     BackgroundColor="Transparent" BorderWidth="0" Aspect="AspectFit"
                                     Clicked="OnFavoriteTapped" SemanticProperties.Description="{Binding Name}"
                                     SemanticProperties.Hint="Dodaj lub usuń z ulubionych">
                            <ImageButton.Source>
                                <MultiBinding Converter="{StaticResource FavoriteHeartConverter}" Mode="OneWay">
                                    <Binding Path="Id" />
                                    <Binding Source="{x:Reference Root}" Path="FavoriteStations" x:DataType="components:StationSearchView" />
                                    <Binding Source="{x:Reference Root}" Path="FavoriteStations.Count" x:DataType="components:StationSearchView" />
                                </MultiBinding>
                            </ImageButton.Source>
                        </ImageButton>

                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Color="#222629" HeightRequest="1" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Brak wyników"
                       FontSize="12"
                       TextColor="#96999F" />
            </CollectionView.EmptyView>
        </CollectionView>

        <Label Grid.Row="4" Text="Przytrzymaj stację, aby dodać do ulubionych"
               FontSize="11" TextColor="#96999F" HorizontalTextAlignment="Center" />
    </Grid>

</ContentView>
