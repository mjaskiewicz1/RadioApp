<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Core.Models;assembly=Core"
             xmlns:enums="clr-namespace:RadioBrowser.Api.Models.Enums;assembly=RadioBrowser"
             xmlns:viewModels="clr-namespace:RadioApp.ViewModels"
             x:Class="RadioApp.Views.Components.StationSearchView"
             x:DataType="viewModels:StationSearchViewModel">

    <VerticalStackLayout Spacing="12">
        <Border HeightRequest="46"
                Padding="12,0,4,0"
                BackgroundColor="#111315"
                Stroke="#222629"
                StrokeShape="RoundRectangle 18">
            <Grid ColumnDefinitions="24,*,40" ColumnSpacing="8">
                <Path Grid.Column="0"
                      Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M12.5,12.5 L18,18"
                      Stroke="#59D65D"
                      StrokeThickness="2"
                      WidthRequest="20"
                      HeightRequest="20"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />

                <Entry Grid.Column="1"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Placeholder="Wyszukaj stację"
                       PlaceholderColor="#96999F"
                       TextColor="#F5F5F5"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="Never"
                       ReturnType="Search"
                       HandlerChanged="OnSearchEntryHandlerChanged"
                       VerticalOptions="Center" />

                <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSearchCommand}" />
                    </Grid.GestureRecognizers>

                    <Path Data="M4,4 L16,16 M16,4 L4,16"
                          Stroke="#96999F"
                          StrokeThickness="2"
                          WidthRequest="18"
                          HeightRequest="18"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Border Grid.Column="0"
                    HeightRequest="38"
                    BackgroundColor="#111315"
                    Stroke="#222629"
                    StrokeShape="RoundRectangle 14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCountryCommand}"
                                          CommandParameter="{x:Static enums:CountryCode.Pl}" />
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedCountry}"
                                 Value="{x:Static enums:CountryCode.Pl}">
                        <Setter Property="BackgroundColor" Value="#101C12" />
                        <Setter Property="Stroke" Value="#59D65D" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Polska"
                       FontSize="12"
                       TextColor="#F5F5F5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Border Grid.Column="1"
                    HeightRequest="38"
                    BackgroundColor="#111315"
                    Stroke="#222629"
                    StrokeShape="RoundRectangle 14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCountryCommand}"
                                          CommandParameter="{x:Static enums:CountryCode.Gb}" />
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedCountry}"
                                 Value="{x:Static enums:CountryCode.Gb}">
                        <Setter Property="BackgroundColor" Value="#101C12" />
                        <Setter Property="Stroke" Value="#59D65D" />
                    </DataTrigger>
                </Border.Triggers>

                <Label Text="Wielka Brytania"
                       FontSize="12"
                       TextColor="#F5F5F5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <Label Margin="0,4,0,0"
               Text="WYNIKI"
               FontAttributes="Bold"
               FontSize="13"
               TextColor="#59D65D" />

        <CollectionView HeightRequest="280"
                        ItemsSource="{Binding Results, Mode=OneWay}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RadioStation">
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStationTapped" />
                        </Grid.GestureRecognizers>

                        <Border Grid.Column="0"
                                HeightRequest="56"
                                WidthRequest="56"
                                Padding="4"
                                BackgroundColor="#111315"
                                Stroke="#222629"
                                StrokeShape="RoundRectangle 14">
                            <Image Source="{Binding Favicon, TargetNullValue=radio_placeholder.svg}"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="14"
                                   TextColor="#F5F5F5"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />

                            <Label Text="{Binding Bitrate, StringFormat='{0} kbps'}"
                                   FontSize="12"
                                   TextColor="#96999F" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Brak wyników"
                       FontSize="12"
                       TextColor="#96999F" />
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>

</ContentView>