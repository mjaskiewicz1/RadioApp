<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:enums="clr-namespace:RadioBrowser.Api.Models.Enums;assembly=RadioBrowser"
             xmlns:models="clr-namespace:Core.Models;assembly=Core"
             xmlns:viewModels="clr-namespace:RadioApp.ViewModels"
             x:Class="RadioApp.Views.Components.SearchView">

    <VerticalStackLayout x:Name="SearchContent" x:DataType="viewModels:SearchViewModel" Spacing="18">

        <VerticalStackLayout Spacing="12" IsVisible="{Binding HasResults}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="WYNIKI WYSZUKIWANIA" FontAttributes="Bold" FontSize="13" TextColor="#59D65D" VerticalOptions="Center" />

                <Border Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0" BackgroundColor="#111315"
                        Stroke="#59D65D" StrokeThickness="2" StrokeShape="RoundRectangle 14"
                        HorizontalOptions="End" VerticalOptions="Center">
                    <Grid>
                        <BoxView WidthRequest="12" HeightRequest="2" Color="#59D65D" Rotation="45"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                        <BoxView WidthRequest="12" HeightRequest="2" Color="#59D65D" Rotation="-45"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <CollectionView ItemsSource="{Binding SearchResults}" SelectionMode="None" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RadioStation">
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStationTapped" />
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0" WidthRequest="58" HeightRequest="58" Padding="3"
                                    BackgroundColor="#111315" Stroke="#222629" StrokeShape="RoundRectangle 12">
                                <Image Source="{Binding Favicon, TargetNullValue=radio_placeholder.svg}"
                                       Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#F5F5F5"
                                       LineBreakMode="TailTruncation" MaxLines="1" />

                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Polska" FontSize="12" TextColor="#96999F" />
                                    <Label Text="•" FontSize="12" TextColor="#96999F" />
                                    <Label Text="{Binding Bitrate, StringFormat='{}{0} kbps', TargetNullValue='— kbps'}"
                                           FontSize="12" TextColor="#96999F" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <ActivityIndicator IsRunning="{Binding SearchCommand.IsRunning}" IsVisible="{Binding SearchCommand.IsRunning}"
                           WidthRequest="30" HeightRequest="30" Color="#59D65D" HorizontalOptions="Center" />

        <Border HeightRequest="54" Padding="16,0" BackgroundColor="#111315" Stroke="#222629" StrokeShape="RoundRectangle 18">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                <Path Grid.Column="0" Data="M9,1 A8,8 0 1,0 9,17 A8,8 0 1,0 9,1 M15,15 L21,21"
                      Stroke="#96999F" StrokeThickness="2" WidthRequest="21" HeightRequest="21"
                      HorizontalOptions="Center" VerticalOptions="Center" />

                <Entry Grid.Column="1" Text="{Binding SearchQuery}" Placeholder="Szukaj stacji"
                       PlaceholderColor="#96999F" TextColor="#F5F5F5" FontSize="16"
                       BackgroundColor="Transparent" ReturnType="Search"
                       ReturnCommand="{Binding SearchCommand}"
                       ReturnCommandParameter="{x:Static enums:CountryCode.Pl}" />
            </Grid>
        </Border>

        <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#96999F" IsVisible="{Binding HasError}" />

    </VerticalStackLayout>

</ContentView>